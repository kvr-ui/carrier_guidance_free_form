# Copy to .env and fill in. Never commit .env.

# MongoDB connection string (Atlas or self-hosted), e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database and collection the registrations are stored in.
MONGODB_DB=focas
MONGODB_COLLECTION=career_guidance_leads

# Password for the /admin page.
ADMIN_PASSWORD=
# Secret used to sign admin login tokens. Any long random string
# (e.g. `openssl rand -hex 32`). Changing it logs every admin out.
ADMIN_TOKEN_SECRET=

# Port the server listens on (serves the site + API).
PORT=7002
